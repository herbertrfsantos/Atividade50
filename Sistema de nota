#include <stdio.h>

int main() {
    float notas[5][3];
    float soma, media, maiorNota = 0.0;

    // Leitura das notas dos 5 alunos (3 notas cada)
    for (int i = 0; i < 5; i++) {
        printf("\n--- Aluno %d ---\n", i + 1);
        for (int j = 0; j < 3; j++) {
            printf("Digite a %da nota: ", j + 1);
            scanf("%f", &notas[i][j]);

            // Verifica se é a maior nota registada na turma
            if ((i == 0 && j == 0) || notas[i][j] > maiorNota) {
                maiorNota = notas[i][j];
            }
        }
    }

    // Cálculo e exibição da média e situação de cada aluno
    printf("\n=== RESULTADOS DA TURMA ===\n");
    for (int i = 0; i < 5; i++) {
        soma = 0.0;
        for (int j = 0; j < 3; j++) {
            soma += notas[i][j];
        }
        media = soma / 3.0;

        printf("Aluno %d - Media: %.2f - Situacao: %s\n",
               i + 1,
               media,
               (media >= 7.0) ? "Aprovado" : "Reprovado");
    }

    printf("\nMaior nota registada na turma: %.2f\n", maiorNota);

    return 0;
}
