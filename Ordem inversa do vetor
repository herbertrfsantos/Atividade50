int main(int argc, char *argv[]) {
	 int numeros[10];
    int i;

    for (i = 0; i < 10; i++) {
        printf("Digite o %do numero: ", i + 1);
        scanf("%d", &numeros[i]);
    }

    printf("\nNumeros na ordem inversa:\n");
    for (i = 9; i >= 0; i--) {
        printf("%d ", numeros[i]);
    }
    printf("\n");
	return 0;
}
