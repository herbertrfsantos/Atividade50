int main(int argc, char *argv[]) {
	int N, i;
	
	printf("Digite um numero inteiro positivo (N): ");
	scanf("%d", &N);
	
	if (N <= 0) {
        printf("Por favor, digite um numero maior que zero.\n");
    } else {
        printf("Contagem de 1 ate %d:\n", N);
        
        for (i = 1; i <= N; i++) {
            printf("%d ", i);
        }
        
        printf("\n"); 
    }
	return 0;
}
