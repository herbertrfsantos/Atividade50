int main(int argc, char *argv[]) {
		float nota1, nota2, nota3;
	float media;
	
	printf("Digite a primeira nota: ");
	scanf("%f", &nota1);
	
	printf("Digite a segunda nota: ");
	scanf("%f", &nota2);
	
	printf("Digite a terceira nota: ");
	scanf("%f", &nota3);
	
	media = (nota1 + nota2 + nota3) / 3;
	
	printf("Media total: %.1f\n", media);
	
	if (media >= 7.0){
		printf("Aprovado");
	}else{
		printf("Reprovado");
	}
	return 0;
}
